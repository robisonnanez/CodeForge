[Unit]
Description=CodeForge scheduler
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=codeforge-web
Group=codeforge
WorkingDirectory=/var/www/codeforge/current
Environment=APP_ENV=production
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codeforge /srv/codeforge /var/log/codeforge
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
