APP_NAME=CodeForge
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://codeforge.local
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
VITE_UI_THEME=atlantis

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=codeforge
DB_USERNAME=codeforge
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=codeforge.local

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

CODEFORGE_REGISTRATION_ENABLED=false
CODEFORGE_DEMO_FEATURES_ENABLED=false
CODEFORGE_REPOSITORIES_ROOT=/srv/codeforge/repositories
CODEFORGE_REPOSITORIES_TRASH_ROOT=/srv/codeforge/trash
CODEFORGE_SSH_HOST=codeforge.local
CODEFORGE_SSH_PORT=2230
CODEFORGE_SSH_USER=git
CODEFORGE_HTTP_CLONE_ENABLED=true
CODEFORGE_MAINTENANCE_LOCK_PATH=/var/lib/codeforge/maintenance.lock
CODEFORGE_HOOK_SOCKET_PATH=/run/codeforge/hook-ingest.sock
CODEFORGE_POST_RECEIVE_HOOK=/usr/local/bin/codeforge-post-receive
